# ============================================================
#  .streamlit/secrets.toml 템플릿
#  이 파일을 복사해서 secrets.toml 로 저장하고
#  실제 값을 채우세요. 절대 GitHub에 올리지 마세요!
# ============================================================

# ── 구글 OAuth ───────────────────────────────────────────────
[oauth]
client_id     = "xxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-xxxx"
redirect_uri  = "https://gil-zabi.streamlit.app/"

# ── 권한 설정 ─────────────────────────────────────────────────
# 아래 이메일 목록에 없으면 자동으로 '학생' 권한
[roles]
admin_emails   = ["admin@school.kr"]
teacher_emails = [
  "teacher1@school.kr",
  "teacher2@school.kr",
]

# ── 관리자 페이지 추가 비밀번호 (선택) ───────────────────────
[admin]
password = "원하는_비밀번호"

# ── Google Sheets 연동 (선택) ─────────────────────────────────
# 이 서비스 계정에는 timetable_id 스프레드시트의 "편집자" 권한을 공유해야
# 사용자 개인 설정(반/선택과목/표시설정)도 함께 저장됩니다.
# (개인 설정은 같은 스프레드시트 안에 user_settings 탭을 자동으로 만들어 씁니다)
[gcp_service_account]
type          = "service_account"
project_id    = "your-project-id"
private_key   = "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
client_email  = "gilzabi@your-project.iam.gserviceaccount.com"
client_id     = "123456789"

[sheets]
timetable_id      = "스프레드시트_ID"
timetable_sheet   = "시간표"
teachers_sheet    = "선생님"
rooms_sheet       = "교실"
# user_settings_id = "다른_스프레드시트_ID"   # 선택: 개인 설정을 별도 시트에 저장하고 싶을 때만
